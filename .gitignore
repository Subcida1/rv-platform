__pycache__/
*.pyc

# Wrangler local cache: contains the account id and account name, and should
# never be committed. It leaked into the history once on 2026-09-21.
workers/.wrangler/
.wrangler/
.dev.vars

# Search Console exports written by scripts/gsc.py. Local measurement data, not site assets.
data/gsc/
.vale/styles/

# Census Gazetteer source files (about 20 MB, public domain, refetched with --fetch).
_data/source/

# Letta agent worktrees. Each one under .letta/worktrees/ is a FULL COPY of this repository, so
# anything that walks the tree -- git, or the site scanners -- has to be told where the checkout
# ends. The scanners were fixed to skip it on 2026-10-04; this is the other half of the same
# boundary, so no git operation can sweep a nested checkout into a commit.
.letta/
.canary.lock

# generated: scan state and reports, not source
_log/

# Link-health REPORT is generated output, rewritten by the nightly timer. The store that holds the
# verdicts lives outside the repo (~/.local/state/linkhealth/), so the repo carries neither. Keeping
# the report out avoids a dirty tree every morning. The design note under _todo/ is tracked.
_reports/
