{
  // OriginRV claim form endpoint. Deploy from this directory:
  //   npx wrangler login     (one time, opens a browser)
  //   npx wrangler deploy
  //
  // The send_email binding is what gives the Worker permission to send. With no
  // destination_address restriction it may send only to VERIFIED destination
  // addresses on the account, which is exactly one inbox, so the deployed URL
  // still cannot be turned into a relay. Which inbox lives in a Worker secret
  // (npx wrangler secret put DESTINATION) rather than here, because this
  // repository is public.
  //
  // Do NOT set destination_address to a routing address such as
  // contact@originrv.com. Routing addresses are not verified destinations and
  // the send fails with E_RECIPIENT_NOT_ALLOWED. Tested on 2026-09-21, not
  // assumed: a throwaway Worker with that destination returned exactly that
  // error.
  "name": "originrv-claim",
  "main": "claim-form.js",
  "compatibility_date": "2026-09-21",
  "send_email": [
    { "name": "EMAIL" }
  ],
  // Two limits, both needed. The per-IP one is the real cap on abuse; the
  // "global" one (a constant key) is a safety net that caps total volume per
  // Cloudflare location, so a distributed script cannot flood the inbox even
  // though it can dodge a per-IP counter. Counters are per-location and
  // eventually consistent, which is fine here: this is a spam brake, not
  // accounting. A real visitor submits once.
  "ratelimits": [
    {
      "name": "CLAIM_PER_IP",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CLAIM_GLOBAL",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
